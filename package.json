{
  "name": "@delthin/pi-cardex",
  "version": "0.4.0",
  "description": "Turn Pi conversations into local Markdown knowledge cards and an offline graph.",
  "type": "module",
  "keywords": ["pi-package", "knowledge-base", "knowledge-graph", "markdown"],
  "author": "Delthin",
  "repository": { "type": "git", "url": "git+https://github.com/Delthin/pi-cardex.git" },
  "homepage": "https://github.com/Delthin/pi-cardex#readme",
  "bugs": { "url": "https://github.com/Delthin/pi-cardex/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.6" },
  "files": ["src", "web", "README.md", "README.zh-CN.md"],
  "pi": {
    "extensions": ["./src/extension.ts"],
    "image": "https://raw.githubusercontent.com/Delthin/pi-cardex/main/demo/preview.png"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-strip-types demo/generate.ts"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.0" }
}
